HOST_IP=127.0.0.1

# MT5 Backend
CUSTOM_USER=admin
PASSWORD=1234
VNC_DOMAIN=vnc.mt5.example.com
API_DOMAIN=api.mt5.example.com
MT5_API_PORT=5001
MT5_API_URL=http://mt5:5001

# MT5 Test Instance
MT5_TEST_API_URL=http://mt5-test:5001
VNC_TEST_DOMAIN=vnc-test.mt5.example.com
API_TEST_DOMAIN=api-test.mt5.example.com

# Basic auth for the MT5 API routers (port 5001 on both mt5 and mt5-test).
# Generate with: echo $(htpasswd -nB admin) | sed -e 's/\$/\$\$/g'
MT5_API_USERNAME=admin
MT5_API_HASHED_PASSWORD=replace_with_bcrypt_hash

# Monitoring
GRAFANA_SERVICE_DOMAIN=grafana.example.com

# Django
DJANGO_SECRET_KEY=''
DJANGO_DEBUG=False
DJANGO_SERVICE_DOMAIN=django.example.com
# Optional superuser auto-creation (used by Django entrypoint)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change_me
DJANGO_SUPERUSER_EMAIL=admin@example.com

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=1234

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=dummyhash
TELEGRAM_API_TARGET_CHANNEL=me
TELEGRAM_API_RESULTS_CHANNEL=me_results

# Superset
SUPERSET_SERVICE_DOMAIN=ganymede.example.com
SUPERSET_SECRET_KEY=generate-a-strong-random-key
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me
SUPERSET_ADMIN_EMAIL=admin@example.com
